{
  "agent-log": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/agent-log-hook.mjs antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "guard-env": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/guard-env.mjs antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
